// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  // NOTE: When using mysql or sqlserver, uncomment the @db.Text annotations in model Account below
  // Further reading:
  // https://next-auth.js.org/adapters/prisma#create-the-prisma-schema
  // https://www.prisma.io/docs/reference/api-reference/prisma-schema-reference#string
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// Necessary for Next auth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  url           String       @default(nanoid())
  fileId        String?
  avatar        File?        @relation(fields: [fileId], references: [id])
  accounts      Account[]
  sessions      Session[]
  teams         UserOnTeam[]
  invitation    Invitation[]
}

// Why is this model needed:
// * Users can upload avatars so Files needs to exist (can be directly referrenced)
// * Posts can have multiple files, so in order to get all Files related to a post we need to have a relation
// 	 since mySQL does not support arrays
model Attachment {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  file      File     @relation(fields: [fileId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
  fileId    String
  postId    String
}

enum FileType {
  image
  video
  gif
}

model File {
  id         String       @id @default(cuid())
  name       String
  size       Int
  mime       String
  extension  String
  height     Int?
  width      Int?
  key        String       @unique
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  attachment Attachment[]
  user       User[]
}

model Post {
  id           String         @id @default(cuid())
  title        String
  content      String
  attachment   Attachment[]
  published    Boolean        @default(false)
  status       String
  scheduledFor DateTime
  profile      TwitterAccount @relation(fields: [profileId], references: [id])
  profileId    String
  author       Team           @relation(fields: [authorId], references: [id])
  authorId     String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

model Team {
  id                       String                   @id @default(cuid())
  name                     String
  url                      String                   @default(nanoid())
  image                    String
  internalProductId        String
  stripeCustomerId         String                   @unique
  stripeSubscriptionId     String                   @unique
  stripeSubscriptionStatus StripeSubscriptionStatus
  members                  UserOnTeam[]
  invitation               Invitation[]
  stripeProduct            StripeProduct            @relation(fields: [internalProductId], references: [id])
  stripeCard               StripeCard[]
  twitterAccount           TwitterAccount[]
  post                     Post[]
}

model TwitterAccount {
  id           String   @id @default(cuid())
  username     String
  accessToken  String
  refreshToken String
  expiresIn    Int
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  post         Post[]

  @@unique([username, teamId])
}

model StripeProduct {
  id              String  @id @default(cuid())
  name            String
  image           String
  price           Int
  priceFormatted  String
  currency        String
  description     String?
  stripeProductId String  @unique
  stripePriceId   String  @unique
  team            Team[]
}

model StripeCard {
  id            String @id @default(cuid())
  brand         String
  type          String
  expMonth      Int
  expYear       Int
  last4         String
  team          Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId        String
  stripeCardId  String @unique
  stripeTokenId String @unique
}

enum StripeSubscriptionStatus {
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

enum UserRole {
  OWNER
  MEMBER
}

model UserOnTeam {
  user   User     @relation(fields: [userId], references: [id])
  team   Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role   UserRole @default(MEMBER)
  userId String
  teamId String

  @@id([userId, teamId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Invitation {
  id          String   @id @default(cuid())
  email       String
  token       String   @default(nanoid())
  expires     DateTime
  hasExpired  Boolean  @default(false)
  hasAccepted Boolean  @default(false)
  role        UserRole
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  teamId      String
  invitedBy   User     @relation(fields: [invitedById], references: [id])
  invitedById String

  @@unique([teamId, token])
}
